# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/placer_ai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=placer_ai
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD

# JWT & Authentication Security
JWT_SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated for production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Resume Storage Security
UPLOAD_DIRECTORY=uploads/resumes
MAX_UPLOAD_SIZE_MB=5

# Vector Store (ChromaDB) Configuration
CHROMA_PERSIST_DIRECTORY=data/chroma
CHROMA_COLLECTION_NAME=placer_ai_jobs

# Ollama & RAG Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60
RAG_TOP_K=5
RAG_MAX_CONTEXT_CHARS=4000
